# Copy to .env on the production host and fill in real values.
# Used by docker-compose.prod.yml; never commit the real .env.

# Public domain pointed (A record) at the VPS running this stack.
DOMAIN=example.com

# Strong, unique password for the gameuser Postgres role in production.
# (docker-compose.yml/.override.yml still use the hardcoded "gamepass" for
# local dev — this only applies when docker-compose.prod.yml is loaded.)
POSTGRES_PASSWORD=change-me
